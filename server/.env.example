# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Default local MongoDB URI for standalone MongoDB Community Server (can inspect with MongoDB Compass)
MONGODB_URI=mongodb://127.0.0.1:27017/7sports

# Client Origin (CORS and Cookie domain)
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=7sports_college_demo_jwt_secret_key_2026_sports
JWT_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_NAME=7sports_token
